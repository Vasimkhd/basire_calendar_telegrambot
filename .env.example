# Token from @BotFather
BOT_TOKEN=

# Exact group title. The bot links itself when it sees this group.
GROUP_TITLE=Basire общий чат

# data/group.json is not in git. Set this on the server, or the bot
# will say it is not in the group until someone sends /start there.
GROUP_CHAT_ID=

# Office clock. Asia/Tashkent is UTC+5.
TIMEZONE=Asia/Tashkent

# ru or en
LANGUAGE=ru

# Read-only schedule page. /calendar sends this address.
# Leave WEB_HOST empty to use this computer's office-network address.
WEB_HOST=
WEB_PORT=3000
