# Token from @BotFather
BOT_TOKEN=

# Exact group title. The bot links itself when it sees this group.


# Optional. Leave empty to link the group automatically.
# If auto-detect fails, send /chatid in the group and paste the id here.
GROUP_CHAT_ID=

# Office clock. Asia/Tashkent is UTC+5.
TIMEZONE=Asia/Tashkent

# ru or en
LANGUAGE=ru

# Read-only schedule page. Open http://0.0.0.0:3000
WEB_PORT=3000
